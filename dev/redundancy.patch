 const ConnSlot* ConnImpl::next(u64 now) noexcept {
     size_t n = slots_.length();
     u64 c = stdAtomicAddAndFetch(&rr_, (u64)1, MemoryOrder::Relaxed) - 1;
@@ -87,12 +179,28 @@ const ConnSlot* ConnImpl::next(u64 now) noexcept {
