@@ -113,7 +220,36 @@ ConnTableImpl::ConnTableImpl(ObjPool* pool, PeerTable* peers, Peer* self, int rc
         }
 
         size_t m = p->dstCount();
-        auto conn = pool->make<ConnImpl>(p->vip(), timeoutMs);
+        size_t total = n * m;
+
